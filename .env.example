# Copy this file to .env and replace the placeholder values.
# The repository keeps .env ignored so secrets stay out of Git.

# Core
ENV=development
LOG_LEVEL=INFO

# Database (optional override)
# DATABASE_URL=sqlite:////app/data/price_tracker.db
# Docker Compose now expects PostgreSQL to run on your host machine, not inside
# the compose stack. Host-local processes can use 127.0.0.1; containers use
# host.docker.internal via the compose extra_hosts mapping.
# DATABASE_URL=postgresql+psycopg://price_tracker:${POSTGRES_PASSWORD}@127.0.0.1:5432/price_tracker
# POSTGRES_DB=price_tracker
# POSTGRES_USER=price_tracker
POSTGRES_PASSWORD=price_tracker
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
# Keep this in sync with the subnet you allow in pg_hba.conf.
DOCKER_SUBNET=172.30.0.0/24

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o-mini
OPENAI_MODEL_CHEAP=gpt-4o-mini

# Telegram (optional but recommended for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to false for the standalone Telegram bot process, which only needs the token.
TELEGRAM_REQUIRE_CHAT_ID=true
# Set to false to keep the scanner running while all Telegram communication is disabled.
TELEGRAM_CONNECTIVITY_ENABLED=true

# Scraping
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
REQUEST_TIMEOUT_SECONDS=15

# Rate limiting
MIN_DELAY_BETWEEN_REQUESTS_SECONDS=3
MAX_DELAY_BETWEEN_REQUESTS_SECONDS=10
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2

# Scheduler
ENABLE_SCHEDULER=true
SCAN_ON_STARTUP=false
ENABLE_CATALOG_SCAN=false
CATALOG_SCAN_INTERVAL_HOURS=6
WATCHLIST_SCAN_INTERVAL_HOURS=1
HOT_ITEMS_SCAN_INTERVAL_MINUTES=15
BRAND_MONITOR_SCAN_INTERVAL_MINUTES=15
BRAND_MONITOR_RESULT_LIMIT=50

# Platforms
ENABLED_PLATFORMS=myntra,ajio,vegnonveg,superkicks

# Notifications
PRICE_DROP_THRESHOLD_PERCENT=10
NEW_PRODUCT_NOTIFICATION_ENABLED=true
RESTOCK_NOTIFICATION_ENABLED=true

# Authentication primitives
# Session cookie name and TTL will be used by the upcoming login flow.
AUTH_SESSION_COOKIE_NAME=price_tracker_session
AUTH_SESSION_TTL_HOURS=168
AUTH_PASSWORD_ITERATIONS=310000
# Required for first-time admin bootstrap registration.
AUTH_BOOTSTRAP_TOKEN=

# Reverse proxy domain (optional, defaults to localhost)
# Set to your domain name for HTTPS with Caddy auto-SSL
# Example: CADDY_DOMAIN=tracker.example.com
# CADDY_DOMAIN=localhost
