# Copy this file to .env and replace the placeholder values.
# The repository keeps .env ignored so secrets stay out of Git.

# Core
ENV=development
LOG_LEVEL=INFO

# Database (optional override)
# DATABASE_URL=sqlite:////app/data/price_tracker.db

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o-mini
OPENAI_MODEL_CHEAP=gpt-4o-mini

# Telegram (optional but recommended for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scraping
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
REQUEST_TIMEOUT_SECONDS=15

# Rate limiting
MIN_DELAY_BETWEEN_REQUESTS_SECONDS=3
MAX_DELAY_BETWEEN_REQUESTS_SECONDS=10
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2

# Scheduler
ENABLE_SCHEDULER=true
CATALOG_SCAN_INTERVAL_HOURS=6
WATCHLIST_SCAN_INTERVAL_HOURS=1
HOT_ITEMS_SCAN_INTERVAL_MINUTES=15

# Platforms
ENABLED_PLATFORMS=myntra,ajio,vegnonveg,superkicks

# Notifications
PRICE_DROP_THRESHOLD_PERCENT=10
NEW_PRODUCT_NOTIFICATION_ENABLED=true
RESTOCK_NOTIFICATION_ENABLED=true

# Dashboard (IMPORTANT: set username and password for production)
# Leave blank to disable dashboard auth (use only for local development)
# For production, set both DASHBOARD_USERNAME and DASHBOARD_PASSWORD
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Reverse proxy domain (optional, defaults to localhost)
# Set to your domain name for HTTPS with Caddy auto-SSL
# Example: CADDY_DOMAIN=tracker.example.com
# CADDY_DOMAIN=localhost
